{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"src/**",
			"tests/**",
			"scripts/**",
			"*.json",
			"*.ts",
			"!package-lock.json",
			"!next-env.d.ts"
		]
	},
	"formatter": { "indentStyle": "tab" },
	"javascript": { "formatter": { "quoteStyle": "single" } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": { "noNonNullAssertion": "off" }
		}
	}
}
